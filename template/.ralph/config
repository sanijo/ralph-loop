# Ralph Loop committed defaults. Keep secrets in ignored .ralph/.env.

RALPH_PROVIDER=opencode
RALPH_MAX_ITERATIONS=1
RALPH_MODEL=openai/gpt-5.5
# Provider-neutral reasoning level: OpenCode model variant, Claude --effort,
# Codex model_reasoning_effort. Empty uses the provider default.
RALPH_EFFORT=high

# Required: exact target-repository verification command, run from its worktree.
RALPH_VERIFY_COMMAND=

# Seconds a provider session may run before it is stopped as a timeout (0 disables).
RALPH_ITERATION_TIMEOUT=3600
# Failures of one issue before its ready label is replaced with needs-info.
RALPH_MAX_FAILURES=2
# Headless Claude turn limit (0 disables).
RALPH_CLAUDE_MAX_TURNS=200

# Equivalent CLI flags:
# .ralph/ralph.sh --model openai/gpt-5.5 --effort high
# Override these defaults in .ralph/.env or with CLI flags to change model selection.

# Triage label strings used for issue selection. Defaults are the canonical names.
# RALPH_LABEL_READY_FOR_AGENT=ready-for-agent
# RALPH_LABEL_NEEDS_TRIAGE=needs-triage
# RALPH_LABEL_NEEDS_INFO=needs-info
# RALPH_LABEL_READY_FOR_HUMAN=ready-for-human
# RALPH_LABEL_WONTFIX=wontfix

